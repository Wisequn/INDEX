# =========================
# Index Monitor 环境变量模板
# =========================

# 项目运行环境（可选）：dev / prod
APP_ENV=prod

# 时区（日志和定时任务建议统一）
TZ=Asia/Shanghai

# Streamlit 端口（生产建议 8504，与已有 8502/8503 错开）
STREAMLIT_PORT=8504

# 生产模式开关
PRODUCTION_MODE=true

# Caddy 配置目录（Alibaba Cloud Linux 常见路径）
CADDY_CONFIG_DIR=/etc/caddy

# CoinGlass API Key（可选）
# 不填：Ahr999 直接用本地公式计算，不再请求公开第三方接口（避免长时间超时）
# 填写：优先走 CoinGlass，失败时再尝试公开源，最后才本地计算
CG_API_KEY=

# 告警邮箱（可选，后续做失败告警可直接复用）
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASS=
