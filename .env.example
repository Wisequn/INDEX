# =========================
# Index Monitor 环境变量模板
# =========================

# 项目运行环境（可选）：dev / prod
APP_ENV=prod

# 时区（日志和定时任务建议统一）
TZ=Asia/Shanghai

# Streamlit 端口（生产建议 8504，与已有 8502/8503 错开）
STREAMLIT_PORT=8504

# 生产模式开关
PRODUCTION_MODE=true

# Caddy 配置目录（Alibaba Cloud Linux 常见路径）
CADDY_CONFIG_DIR=/etc/caddy

# CoinGlass API Key（可选）
# 不填：Ahr999 直接用本地公式计算，不再请求公开第三方接口（避免长时间超时）
# 填写：优先走 CoinGlass，失败时再尝试公开源，最后才本地计算
CG_API_KEY=

# Binance API（可选，当前实时更新默认用公开 ticker 接口，不填也可运行）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------- Telegram 推送（实时告警 + 每日早报）----------
# 说明：复制本文件为 .env 后填写；.env 不会提交到 Git。
# 服务器：把 Mac 上已测通的 .env 复制到 /opt/INDEX/.env 即可（见 README 或问 Cursor）。
# 1) 与 @BotFather 对话创建 Bot，拿到 TELEGRAM_BOT_TOKEN
# 2) 给 Bot 发一条消息后访问 https://api.telegram.org/bot<TOKEN>/getUpdates 获取 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 可选：企业微信/钉钉等通用 Webhook（POST JSON: {"text":"..."}）
ALERT_WEBHOOK_URL=
# 设为 0 时 realtime_update 仍跑打分检测，但不外发（写入 logs/realtime_alerts.log）
ALERT_PUSH_ENABLED=1

# 告警邮箱（可选，后续做失败告警可直接复用）
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASS=
