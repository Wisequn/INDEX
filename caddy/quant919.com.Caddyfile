# ================================
# www.quant919.com - Index Monitor
# Caddy v2 配置片段（生产环境）
# ================================
#
# 使用说明：
# 1) 把本文件内容合并到 /etc/caddy/Caddyfile

www.quant919.com {
    # Caddy 默认会自动申请和续期 HTTPS 证书
    encode zstd gzip

    # 反向代理到本机 Streamlit（仅监听 127.0.0.1:8504）
    reverse_proxy 127.0.0.1:8504

    # 建议保留访问日志，方便排查线上问题
    log {
        output file /var/log/caddy/quant919_access.log
        format console
    }
}
